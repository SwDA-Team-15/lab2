# MZinga API Configuration (still needed for depth=1 fetch and write-back)
MZINGA_API_URL=http://localhost:3000/api
MZINGA_ADMIN_EMAIL=admin@admin.com
MZINGA_ADMIN_PASSWORD=admin

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost/
EXCHANGE_NAME=mzinga_events_durable
QUEUE_NAME=communications-email-worker
ROUTING_KEY=HOOKSURL_COMMUNICATIONS_AFTERCHANGE

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=worker@mzinga.io